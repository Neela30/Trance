<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
{# Strict CSP: the report is static HTML + inline CSS and needs no script, network, frame or
   form. Evidence text is autoescaped (report.py); this is the second layer if anything ever
   slips through -- no script runs, nothing loads from anywhere. Keep it the first thing in
   <head> after the charset, before any evidence-derived text (the <title>). #}
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; script-src 'none'; object-src 'none'; frame-src 'none'; connect-src 'none'; font-src 'none'; media-src 'none'; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TRANCE — {{ findings.case.name }}</title>
<style>
  :root {
    --bg: #eef1f0; --surface: #ffffff; --surface-2: #e3e7e6; --ink: #1b2226; --ink-muted: #5b6570;
    --border: #c7cdcc; --accent: #a23e2a; --accent-bg: #f3e1dc; --confirm: #2f7a5c; --confirm-bg: #e1efe8;
    --noise: #92702c; --noise-bg: #efe9d8; --mono-chip-bg: #e7ebea;
    --shadow: 0 1px 2px rgba(20, 24, 27, 0.06), 0 6px 20px rgba(20, 24, 27, 0.05);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #14181b; --surface: #1b2126; --surface-2: #232a2f; --ink: #dce2e6; --ink-muted: #8b969c;
      --border: #313a40; --accent: #e2694f; --accent-bg: #33211c; --confirm: #4fae84; --confirm-bg: #1e2e27;
      --noise: #c9a552; --noise-bg: #2c2818; --mono-chip-bg: #232a2f;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
    }
  }
  :root[data-theme="dark"] {
    --bg: #14181b; --surface: #1b2126; --surface-2: #232a2f; --ink: #dce2e6; --ink-muted: #8b969c;
    --border: #313a40; --accent: #e2694f; --accent-bg: #33211c; --confirm: #4fae84; --confirm-bg: #1e2e27;
    --noise: #c9a552; --noise-bg: #2c2818; --mono-chip-bg: #232a2f;
    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
  }
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--ink); margin: 0; font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; line-height: 1.55; }
  .page { max-width: 1000px; margin: 0 auto; padding: 40px 24px 80px; }
  h1, h2, h3 { font-family: Georgia, "Iowan Old Style", "Times New Roman", serif; text-wrap: balance; margin: 0; color: var(--ink); }
  .band-subtitle { font-size: 13.5px; color: var(--ink-muted); margin-top: 6px; }
  .eyebrow { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); }
  code, .mono { font-family: ui-monospace, "Cascadia Code", Consolas, "Liberation Mono", monospace; }
  .masthead { display: flex; flex-direction: column; gap: 18px; padding-bottom: 28px; border-bottom: 2px solid var(--ink); margin-bottom: 32px; }
  .masthead-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .masthead h1 { font-size: 30px; font-weight: 600; margin-top: 6px; }
  .stamp { font-family: ui-monospace, monospace; font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); border: 1.5px solid var(--accent); border-radius: 3px; padding: 7px 10px; transform: rotate(-2deg); white-space: nowrap; flex-shrink: 0; }
  .meta-grid { display: grid; grid-template-columns: 130px 1fr; gap: 6px 14px; font-size: 13px; }
  .meta-grid dt { color: var(--ink-muted); font-family: ui-monospace, monospace; font-size: 11px; letter-spacing: .04em; text-transform: uppercase; padding-top: 2px; }
  .meta-grid dd { margin: 0; font-family: ui-monospace, monospace; font-size: 12.5px; overflow-wrap: anywhere; }
  .flag-warn { color: var(--noise); font-weight: 600; }
  .flag-ok { color: var(--confirm); font-weight: 600; }
  section { margin-bottom: 44px; }
  .band { border-top: 2px solid var(--ink); padding-top: 22px; margin-top: 52px; }
  .band .eyebrow { margin-bottom: 4px; }
  .band h2 { font-size: 24px; font-weight: 600; margin-bottom: 20px; }
  .section-head { margin-bottom: 16px; }
  .section-head h2 { font-size: 20px; font-weight: 600; }
  .section-head .count { display: block; margin-top: 4px; font-family: ui-monospace, monospace; font-size: 12px; color: var(--ink-muted); }
  .keyfinding { background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 6px; padding: 18px 20px; box-shadow: var(--shadow); margin-bottom: 8px; }
  .keyfinding .eyebrow { display: block; margin-bottom: 8px; }
  .keyfinding p { font-size: 16px; font-weight: 500; margin: 0; }
  p { margin: 0 0 12px; color: var(--ink); }
  .note { font-size: 13.5px; color: var(--ink-muted); }
  .narrative-list { margin: 0 0 16px; padding-left: 22px; }
  .narrative-list li { margin-bottom: 8px; color: var(--ink); line-height: 1.5; }
  .glossary dt { font-family: ui-monospace, monospace; font-weight: 600; color: var(--ink); margin-top: 10px; }
  .glossary dd { color: var(--ink-muted); margin: 2px 0 0; }
  .tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .tiles.three { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 560px) { .tiles, .tiles.three { grid-template-columns: 1fr; } }
  .tile { background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--confirm); border-radius: 6px; padding: 16px 18px; box-shadow: var(--shadow); }
  .tile.gap { border-left-color: var(--noise); }
  .tile.warn { border-left-color: var(--noise); }
  .tile.err { border-left-color: var(--accent); }
  .tile h3 { font-size: 15px; margin-bottom: 6px; }
  .tile p { font-size: 13px; color: var(--ink-muted); margin-bottom: 0; }
  .tile .tile-value { font-family: ui-monospace, monospace; font-size: 12px; color: var(--ink); background: var(--mono-chip-bg); border-radius: 4px; padding: 4px 7px; display: inline-block; margin-top: 6px; overflow-wrap: anywhere; }
  .evidence-table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; box-shadow: var(--shadow); font-size: 13px; }
  .evidence-table th { text-align: left; font-family: ui-monospace, monospace; font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-muted); padding: 10px 14px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
  .evidence-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .evidence-table tr:last-child td { border-bottom: none; }
  .evidence-table .val { font-family: ui-monospace, monospace; font-size: 12px; overflow-wrap: anywhere; }
  .evidence-table .off { font-family: ui-monospace, monospace; font-size: 11.5px; color: var(--ink-muted); white-space: nowrap; }
  .table-scroll { overflow-x: auto; }
  .chip { display: inline-block; font-family: ui-monospace, monospace; font-size: 10px; letter-spacing: .05em; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; white-space: nowrap; }
  .chip.high, .chip.ok { background: var(--confirm-bg); color: var(--confirm); }
  .chip.low, .chip.skipped, .chip.not_implemented, .chip.partial { background: var(--noise-bg); color: var(--noise); }
  .chip.error { background: var(--accent-bg); color: var(--accent); }
  .chip.interp { background: var(--noise-bg); color: var(--noise); margin-left: 8px; vertical-align: middle; }
  .sign-grid { display: grid; grid-template-columns: 150px 1fr; gap: 22px 14px; margin-top: 18px; font-size: 13px; }
  .sign-grid dt { color: var(--ink-muted); font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; padding-top: 6px; }
  .sign-grid dd { margin: 0; border-bottom: 1px solid var(--ink); min-height: 26px; }
  .declaration { break-inside: avoid; }
  .chip.verified { background: var(--confirm-bg); color: var(--confirm); }
  .chip.unrecorded, .chip.not_hashed { background: var(--noise-bg); color: var(--noise); }
  .chip.MISMATCH, .chip.missing { background: var(--accent-bg); color: var(--accent); }
  .hash { font-family: ui-monospace, monospace; font-size: 11px; word-break: break-all; }
  .path-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .path-pill { font-family: ui-monospace, monospace; font-size: 12.5px; background: var(--surface); border: 1px solid var(--border); border-radius: 5px; padding: 5px 10px; }
  .path-pill.odd { border-color: var(--noise); color: var(--noise); }
  .ribbon { background: var(--noise-bg); color: var(--noise); border: 1px solid var(--noise); border-radius: 6px; padding: 12px 16px; font-size: 13px; margin-bottom: 18px; }
  .ribbon strong { color: var(--noise); }
  .sequence { list-style: none; padding: 0; margin: 0; counter-reset: seq; }
  .sequence li { counter-increment: seq; display: grid; grid-template-columns: 30px 1fr; gap: 4px 12px; padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 13.5px; align-items: baseline; }
  .sequence li::before { content: counter(seq); font-family: ui-monospace, monospace; font-size: 11px; color: var(--ink-muted); text-align: right; }
  .sequence li:last-child { border-bottom: none; }
  .seq-off { grid-column: 2; font-family: ui-monospace, monospace; font-size: 10.5px; color: var(--ink-muted); }
  .seq-type { font-family: ui-monospace, monospace; font-size: 9.5px; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-muted); margin-right: 6px; }
  .seq-flag { font-size: 10px; color: var(--accent); font-family: ui-monospace, monospace; margin-left: 6px; }
  .callout { background: var(--surface-2); border-left: 3px solid var(--accent); border-radius: 0 5px 5px 0; padding: 10px 14px; font-size: 12.5px; color: var(--ink-muted); margin: 10px 0 14px; }
  .callout strong { color: var(--ink); }
  details.appendix { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 4px 16px; }
  details.appendix summary { cursor: pointer; padding: 12px 0; font-family: ui-monospace, monospace; font-size: 12.5px; color: var(--ink-muted); }
  details.appendix summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .appendix-body { padding-bottom: 14px; }
  .appendix-row { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; padding: 6px 0; border-top: 1px solid var(--border); }
  .appendix-row .val { font-family: ui-monospace, monospace; color: var(--ink-muted); overflow-wrap: anywhere; }
  .appendix-row .why { color: var(--ink-muted); text-align: right; flex-shrink: 0; max-width: 40%; }
  .reco-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .reco-list li { position: relative; font-size: 13.5px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px 12px 44px; }
  .reco-list li::before { content: "→"; position: absolute; left: 14px; top: 12px; color: var(--accent); font-weight: 600; }
  footer { margin-top: 56px; padding-top: 18px; border-top: 1px solid var(--border); font-family: ui-monospace, monospace; font-size: 11px; color: var(--ink-muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }

  /* Print / PDF: always the light palette on white, every collapsed section expanded (see
     the script below), the case and page number on every page so a loose page can be put
     back, and findings.json's hash in each page's footer to tie paper to file. */
  @page {
    size: A4;
    margin: 18mm 14mm 20mm;
    @top-left { content: {{ ("TRANCE · Case " ~ findings.case.name)|css_string }}; font: 8pt ui-monospace, monospace; color: #5b6570; }
    @top-right { content: {{ ("Generated " ~ findings.generated_at[:19] ~ " UTC")|css_string }}; font: 8pt ui-monospace, monospace; color: #5b6570; }
    @bottom-left { content: {{ ("findings.json SHA-256 " ~ (findings_sha256 or "not recorded"))|css_string }}; font: 6.5pt ui-monospace, monospace; color: #5b6570; }
    @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 8pt ui-monospace, monospace; color: #5b6570; }
  }
  @media print {
    :root, :root[data-theme="dark"], :root:not([data-theme="light"]) {
      --bg: #ffffff; --surface: #ffffff; --surface-2: #f1f3f3; --ink: #111518; --ink-muted: #4a535c;
      --border: #b9c0bf; --accent: #9a3522; --accent-bg: #f6e4df; --confirm: #23664b; --confirm-bg: #e3f0e9;
      --noise: #7d5f20; --noise-bg: #f2ecdc; --mono-chip-bg: #eef0f0; --shadow: none;
    }
    html, body { background: #ffffff; }
    body { font-size: 10.5pt; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .page { max-width: none; padding: 0; }
    .table-scroll { overflow: visible; }
    table { page-break-inside: auto; }
    thead { display: table-header-group; }
    tr, .tile, .callout, .reco-list li, .sequence li { break-inside: avoid; }
    h1, h2, h3, .section-head, .eyebrow { break-after: avoid; }
    .band { break-before: page; margin-top: 0; }
    details.appendix summary { list-style: none; color: var(--ink); }
    details summary::-webkit-details-marker { display: none; }
    /* Print collapsed <details> open, without script (Chrome 131+; the app's Save as PDF
       also opens them). */
    details::details-content { content-visibility: visible; display: block; }
    .stamp { transform: none; }
    a { color: inherit; text-decoration: none; }
    footer { display: none; }
  }
</style>
</head>
<body>
<div class="page">

  {% set modules = findings.modules %}
  {% set ok_count = modules.values()|selectattr("status", "equalto", "ok")|list|length %}

  <div class="masthead">
    <div class="masthead-top">
      <div>
        <div class="eyebrow">TRANCE · Forensic Artifact Triage · Case Report</div>
        <h1>{{ findings.case.name }}</h1>
      </div>
      <div class="stamp">Forensic examination report<br>Not valid unless signed</div>
    </div>
    <dl class="meta-grid">
      <dt>Generated</dt><dd>{{ findings.generated_at }}</dd>
      <dt>Modules</dt><dd>{{ ok_count }} of {{ modules|length }} ran cleanly</dd>
      <dt>Artifacts</dt><dd>{{ findings.artifacts|length }} across all modules</dd>
      <dt>Output dir</dt><dd>{{ findings.case.output_dir|wrap_path }}</dd>
      {% if findings.case.evidence_dir %}<dt>Evidence dir</dt><dd>{{ findings.case.evidence_dir|wrap_path }}</dd>{% endif %}
      {% if provenance %}<dt>Tool</dt><dd>TRANCE {{ provenance.tool.version }}{% if provenance.tool.git_commit %} · commit <span class="mono">{{ provenance.tool.git_commit[:12] }}</span>{% if provenance.tool.git_dirty %} (modified){% endif %}{% endif %}</dd>{% endif %}
    </dl>
  </div>

  {% set integrity = findings.evidence_integrity %}
  {% if integrity and integrity.status == 'failed' %}
  <div class="callout" style="border-left-color: var(--accent); border-left-width: 5px; font-size: 14px;">
    <strong>Evidence integrity check failed — nothing was analysed.</strong> {{ integrity.message }}
    {% if integrity.mismatched %}<br>Changed since acquisition: {% for m in integrity.mismatched[:20] %}<span class="mono">{{ m.path }}</span>{{ ", " if not loop.last }}{% endfor %}{% if integrity.mismatched|length > 20 %} (+{{ integrity.mismatched|length - 20 }} more){% endif %}.{% endif %}
    {% if integrity.invalid %}<br>Unsafe or unreadable: {% for i in integrity.invalid[:20] %}<span class="mono">{{ i.record }}</span> ({{ i.reason }}){{ "; " if not loop.last }}{% endfor %}.{% endif %}
    <br>Re-copy the evidence from the original acquisition media and run the analysis again.
  </div>
  {% elif integrity and integrity.status in ['verified', 'unverified'] %}
  <div class="callout" style="border-left-color: {{ 'var(--confirm)' if integrity.status == 'verified' and not integrity.missing else 'var(--noise)' }};">
    <strong>Evidence integrity:</strong> {{ integrity.message }}
    {% if integrity.missing %}<br>Missing: {% for m in integrity.missing[:10] %}<span class="mono">{{ m.path }}</span>{{ ", " if not loop.last }}{% endfor %}{% if integrity.missing|length > 10 %} (+{{ integrity.missing|length - 10 }} more){% endif %}.{% endif %}
  </div>
  {% endif %}

  <section>
    <div class="callout" style="border-left-color: var(--ink-muted);">
      <strong>How to read this report.</strong> Tables, counts, timestamps and hashes are data
      recorded in the evidence and are reported as found. Sections marked
      <span class="chip interp" style="margin-left:0;">Interpretation</span> are conclusions drawn
      from that data by fixed, documented rules in TRANCE {{ provenance.tool.version if provenance else "" }};
      they are opinion for the examiner to confirm, not facts in themselves. All times are UTC
      unless a local time is shown beside them. The methods, their limits and the tool's tested
      accuracy follow the findings. Only Tor-related data is printed; everything TRANCE
      recorded, including the rest of the machine's processes, networks and devices, is in
      findings.json, whose SHA-256 is printed on every page.
    </div>
  </section>

  <section>
    <div class="section-head"><h2>Module status</h2></div>
    <div class="tiles three">
      {% for name, m in modules.items() %}
      {% set tile_class = 'err' if m.status == 'error' else ('warn' if m.status == 'partial' else ('gap' if m.status != 'ok' else '')) %}
      <div class="tile{{ ' ' + tile_class if tile_class }}">
        <h3 class="mono" style="font-size:13px;">{{ name }}</h3>
        <p><span class="chip {{ m.status }}">{{ m.status.replace('_', ' ') }}</span>
        {% if m.status in ['ok', 'partial'] %} · {{ m.artifact_count }} artifact{{ 's' if m.artifact_count != 1 }}{% endif %}</p>
        {% if m.status == 'partial' and m.warnings %}
        <ul style="margin-top:8px; padding-left:16px; font-size:12px; color:var(--ink-muted);">
          {% for w in m.warnings %}
          <li><span class="mono">{{ w.artifact_type }}</span>{% if w.source %} ({{ w.source }}){% endif %}: {{ w.reason }}</li>
          {% endfor %}
        </ul>
        {% elif m.message %}<p style="margin-top:6px;">{{ m.message }}</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>

  {% if provenance %}
  {% set items = provenance.evidence_items %}
  {% set bad = items|selectattr("status", "in", ["MISMATCH", "missing"])|list %}
  <section>
    <div class="section-head"><h2>Evidence examined</h2><span class="count">{{ items|length }} item{{ "s" if items|length != 1 }} · SHA-256 checked against the hash recorded at acquisition</span></div>
    {% if bad %}
    <div class="callout"><strong>{{ bad|length }} evidence item{{ "s" if bad|length != 1 }} did not verify.</strong> A file that is missing or whose hash differs from the one recorded at acquisition cannot be shown to be the evidence that was collected; findings drawn from it should not be relied on until the difference is explained.</div>
    {% endif %}
    {% if items %}
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Item</th><th>File</th><th>Size</th><th>SHA-256 (now)</th><th>Check</th></tr></thead>
        <tbody>
          {% for it in evidence_rows %}
          <tr>
            <td>{{ it.label }}</td>
            <td class="mono" style="font-size:12px;">{{ it.path|relative_to(findings.case.evidence_dir)|wrap_path }}{% if it.note %}<div class="note" style="font-size:11.5px;">{{ it.note }}</div>{% endif %}</td>
            <td class="mono" style="font-size:12px; white-space:nowrap;">{{ it.size_bytes|fmt_bytes }}</td>
            <td class="hash">{{ it.sha256 or ("see findings.json" if it.kind == "folder" else "—") }}{% if it.status == "MISMATCH" and it.acquisition_sha256 %}<div style="color:var(--accent);">recorded at acquisition: {{ it.acquisition_sha256 }}</div>{% endif %}</td>
            <td><span class="chip {{ it.status }}">{{ {"verified": "matches acquisition", "MISMATCH": "hash differs", "unrecorded": "no acquisition hash", "missing": "missing", "not_hashed": "not hashed"}.get(it.status, it.status) }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="note">No evidence files were supplied to this analysis.</p>
    {% endif %}
  </section>

  <section>
    <div class="section-head"><h2>Analysis provenance</h2><span class="count">what produced this report — needed to repeat the analysis and get the same result</span></div>
    <dl class="meta-grid">
      <dt>Tool</dt><dd>TRANCE {{ provenance.tool.version }}{{ " (packaged build)" if provenance.tool.packaged }}</dd>
      <dt>Source commit</dt><dd>{% if provenance.tool.git_commit %}<span class="mono">{{ provenance.tool.git_commit }}</span>{% if provenance.tool.git_dirty %} — <strong>with uncommitted changes</strong>; the exact code is not recoverable from this commit alone{% endif %}{% else %}not recorded{% endif %}</dd>
      <dt>Analysis ran</dt><dd>{{ provenance.analysis_started_at }} → {{ provenance.analysis_finished_at }}</dd>
      <dt>Examiner machine</dt><dd>{{ provenance.runtime.hostname }}{% if provenance.runtime.user %} · user {{ provenance.runtime.user }}{% endif %} · {{ provenance.runtime.platform }} · Python {{ provenance.runtime.python }}</dd>
      <dt>Libraries</dt><dd class="mono" style="font-size:12px;">{% for name, v in provenance.runtime.libraries.items() if v %}{{ name }} {{ v }}{{ " · " if not loop.last }}{% endfor %}</dd>
      {% set acq = provenance.acquisition %}
      {% if acq %}
      <dt>Acquired</dt><dd>{{ acq.acquired_at or "time not recorded" }}{% if acq.acquired_by %} on {{ acq.acquired_by.hostname or "unknown host" }}{% if acq.acquired_by.os %} ({{ acq.acquired_by.os }}){% endif %}{% if acq.acquired_by.user %} by {{ acq.acquired_by.user }}{% endif %} with {{ acq.acquired_by.tool or "trance-acquire" }} {{ acq.acquired_by.version or "" }}{% endif %}</dd>
      <dt>Acquisition manifest</dt><dd>{{ acq.manifest|wrap_path }}{% if acq.manifest_sha256 %}<div class="hash">SHA-256 {{ acq.manifest_sha256 }}</div>{% endif %}</dd>
      {% if acq.winpmem_path %}<dt>Memory imager</dt><dd>{{ acq.winpmem_path|wrap_path }}{% if acq.winpmem_sha256 %}<div class="hash">SHA-256 {{ acq.winpmem_sha256 }}</div>{% endif %}</dd>{% endif %}
      {% if acq.custody_logs %}<dt>Acquisition custody logs</dt><dd class="mono" style="font-size:12px;">{% for c in acq.custody_logs %}{{ c|wrap_path }}{{ "; " if not loop.last }}{% endfor %}</dd>{% endif %}
      {% else %}
      <dt>Acquired</dt><dd>No <span class="mono">acquire_manifest.json</span> with this evidence — acquisition details are not recorded here.</dd>
      {% endif %}
    </dl>
  </section>
  {% endif %}

  <section>
    <div class="section-head"><h2>Methodology</h2><span class="count">how each kind of evidence was examined</span></div>
    <ul class="narrative-list">
      <li>Evidence was examined read-only. Each input's SHA-256 was compared with the hash recorded when it was acquired (see "Evidence examined"); browser databases were opened only on verified, disposable working copies, and registry hives were hashed again after parsing to show they were not changed.</li>
      {% if modules.module_a_registry and modules.module_a_registry.status in ["ok", "partial"] %}
      <li><strong>Registry (Module A).</strong> The SYSTEM, SOFTWARE, NTUSER.DAT, UsrClass.dat and Amcache.hve hives were parsed with regipy {{ provenance.runtime.libraries.regipy if provenance and provenance.runtime.libraries.regipy else "" }} and TRANCE's own parsers for execution records (UserAssist, BAM, ShimCache, Amcache, MUICache), file and folder access (RecentDocs, ShellBags, open/save dialogs), devices, networks and autostart settings. Entries were kept when their path or program name matches Tor Browser; device, network and machine facts are kept only alongside at least one such entry.</li>
      {% endif %}
      {% if modules.module_b_disk and modules.module_b_disk.status in ["ok", "partial"] %}
      <li><strong>Disk (Module B).</strong> The Tor Browser profile databases and the Tor daemon's data folder were read for bookmarks, history, guard relays and session times; internet-origin files (Zone.Identifier) were placed against the Tor session window; where supplied, the NTFS $MFT and $UsnJrnl were parsed for file activity and deleted files, and the pagefile, swapfile and raw disk bytes were searched for onion addresses.</li>
      {% endif %}
      {% if modules.module_c_memory and modules.module_c_memory.status in ["ok", "partial"] %}
      <li><strong>Memory (Module C).</strong> Printable ASCII and UTF-16 strings were extracted from the memory image and matched against fixed patterns for URLs, cookies, credentials, form submissions, page titles, searches and downloads. On a whole-memory image a match counts as a finding only when tied to the target onion address or host given for the case; every other match is kept as an observation in findings.json.{% if memory and memory.volatility3 and memory.volatility3.status == "ok" %} Process and network structures were read with Volatility 3.{% endif %}</li>
      {% endif %}
      <li>Every rule is deterministic: the same inputs and the same TRANCE version give the same findings. No machine-learning or generative model is used.</li>
    </ul>
  </section>

  {% if registry %}
  <div class="band">
    <div class="eyebrow">Module A</div>
    <h2>Registry &amp; execution evidence</h2>
    <p class="band-subtitle">What the Windows registry shows about Tor Browser being installed and used.</p>
    <dl class="meta-grid" style="margin-bottom:32px;">
      <dt>Hives analyzed</dt><dd>{{ registry.hives_analyzed|join(", ") if registry.hives_analyzed else "— none" }}</dd>
      {% if registry.hives_missing %}
      <dt>Hives not provided</dt><dd>{{ registry.hives_missing|join(", ") }}</dd>
      {% endif %}
    </dl>
  </div>

  {% if registry.narrative.device_story %}
  <section>
    <div class="section-head"><h2>Where Tor Browser ran from<span class="chip interp">Interpretation</span></h2></div>
    <ul class="narrative-list">
      {% for line in registry.narrative.device_story %}
      <li>{{ line }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if registry.network_context and (registry.network_context.profiles or registry.network_context.interfaces) %}
  {% set net = registry.network_context %}
  <section>
    <div class="section-head"><h2>Network context at time of use<span class="chip interp">Interpretation</span></h2></div>
    {% if net.narrative.correlation %}
    <ul class="narrative-list">
      {% for line in net.narrative.correlation %}
      <li>{{ line }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="note">No network connection could be correlated with Tor Browser's use.</p>
    {% endif %}
    {% for line in net.narrative.caveats %}
    <p class="note">{{ line }}</p>
    {% endfor %}
  </section>
  {% endif %}

  {% if registry.autostart_context and registry.autostart_context.narrative %}
  <section>
    <div class="section-head"><h2>Automatic start and proxy settings</h2></div>
    <ul class="narrative-list">
      {% for line in registry.autostart_context.narrative %}
      <li>{{ line }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if registry.files_involved %}
  <section>
    <div class="section-head">
      <h2>Files involved</h2>
      <span class="count">{{ registry.files_involved|length }} file{{ "s" if registry.files_involved|length != 1 }} opened, saved, or browsed to by Tor Browser or inside its folder</span>
    </div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Path</th><th>Source</th><th>Timestamp</th></tr></thead>
        <tbody>
          {% for f in registry.files_involved %}
          <tr>
            <td class="val">{{ f.path|wrap_path }}</td>
            <td class="off">{{ f.source }}</td>
            <td class="off">{{ f.timestamp|fmt_ts }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  {% if registry.errors %}
  <section>
    <div class="callout">
      {% if registry.extraction_warnings %}
      {% for line in registry.extraction_warnings %}
      <p{% if not loop.first %} style="margin-top:6px;"{% endif %}>{{ line }}</p>
      {% endfor %}
      <details style="margin-top:10px;">
        <summary class="note" style="cursor:pointer;">Technical detail</summary>
        <ul style="margin:8px 0 0; padding-left:18px;">
          {% for err in registry.errors %}
          <li class="mono" style="font-size:12px;">{{ err }}</li>
          {% endfor %}
        </ul>
      </details>
      {% else %}
      <strong>Extraction errors:</strong> the findings below are from whichever hives/plugins succeeded; these did not.
      <ul style="margin:8px 0 0; padding-left:18px;">
        {% for err in registry.errors %}
        <li class="mono" style="font-size:12px;">{{ err }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <section>
    <div class="section-head"><h2>What happened<span class="chip interp">Interpretation</span></h2><span class="count">Plain-English summary — rule-based, not an AI-generated guess</span></div>
    {% if registry.narrative.empty %}
    {% for line in registry.narrative.empty %}
    <p class="note">{{ line }}</p>
    {% endfor %}
    {% else %}
    <ol class="narrative-list">
      {% for point in registry.narrative.timeline %}
      <li>{{ point }}</li>
      {% endfor %}
    </ol>
    {% endif %}
  </section>

  {% if not registry.narrative.empty %}
  <section>
    <div class="section-head"><h2>How reliable is this?<span class="chip interp">Interpretation</span></h2></div>
    {% for line in registry.narrative.reliability %}
    <p class="note">{{ line }}</p>
    {% endfor %}
  </section>

  {% if registry.narrative.not_determined %}
  <section>
    <div class="section-head"><h2>What we could not determine</h2></div>
    <ul class="narrative-list">
      {% for line in registry.narrative.not_determined %}
      <li>{{ line }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
  {% endif %}

  <div class="band">
    <div class="eyebrow">Module A — for examiners</div>
    <h2>Technical details</h2>
    <p class="band-subtitle">The registry tables and source-by-source evidence the summary above is built from.</p>
  </div>

  <section>
    <div class="section-head">
      <h2>Confirmed Tor Browser components</h2>
      <span class="count">{{ registry.component_timeline|length }} distinct file{{ "s" if registry.component_timeline|length != 1 }} — {{ registry.corroborated_components }} corroborated by 2+ independent hive sources</span>
    </div>
    {% if registry.component_timeline %}
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>File</th><th>Seen in</th><th>Install / first seen</th><th>Run count</th><th>Last activity</th></tr></thead>
        <tbody>
          {% for c in registry.component_timeline %}
          <tr>
            <td class="val">{{ c.basename|wrap_path }}{% if c.paths|length > 1 %}<br><span class="off">({{ c.paths|length }} path variants)</span>{% endif %}</td>
            <td class="val">{% for t in c.seen_in %}<span class="chip {{ 'high' if t in ('UserAssist', 'Amcache', 'BAM', 'InstalledPrograms') else 'low' if t in ('RecentDocs', 'RunMRU', 'WordWheelQuery', 'ComDlg32') else '' }}">{{ t }}{% if t == 'ShimCache' and c.shimcache_hits > 1 %} ×{{ c.shimcache_hits }}{% endif %}</span> {% endfor %}</td>
            <td class="off">{{ c.amcache_first_seen|fmt_ts }}</td>
            <td class="off">{{ c.userassist_run_count or "—" }}</td>
            <td class="off">{% if c.last_activity %}{{ c.last_activity.timestamp|fmt_ts }} <span class="off">({{ c.last_activity.source }})</span>{% else %}—{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if registry.corroborated_components %}
    <div class="callout">
      <strong>Independent corroboration:</strong> {{ registry.corroborated_components }} file{{ "s" if registry.corroborated_components != 1 }} above {{ "is" if registry.corroborated_components == 1 else "are" }} confirmed by 2 or more separate OS subsystems (execution history, cache insertion, install record) agreeing independently — stronger than any single artifact type's say-so alone.
    </div>
    {% endif %}
    {# Last use, BAM gap, strength and install date are already stated in "What happened" / "How reliable". #}
    <p class="note" style="margin-top:12px;">{{ registry.narrative.technical.account }}</p>
    {% for note in registry.quiet_hive_notes %}
    <p class="note">{{ note }}</p>
    {% endfor %}
    {% for link in registry.linked_launches %}
    <p class="note">Same instant, likely one action (a shortcut and the program it started), not two sources: {{ link.timestamp|fmt_ts }} — {{ link.paths|join(" ↔ ") }}</p>
    {% endfor %}
    {% else %}
    <p class="note">No cross-referenceable registry components found.</p>
    {% endif %}
  </section>

  <section>
    <div class="section-head"><h2>Raw findings by hive</h2><span class="count">{{ registry.total_findings }} finding{{ "s" if registry.total_findings != 1 }}, deduplicated — what the table above was built from</span></div>
    {% if registry.sections %}
    <details class="appendix">
      <summary>Show per-hive detail</summary>
      <div class="appendix-body">
        {% for s in registry.sections %}
        <div class="section-head" style="margin-top:22px;">
          <h3 style="font-size:15px; font-weight:600;">{{ s.label }}</h3>
          <span class="count"><span class="chip {{ 'high' if s.confidence == 'high' else ('low' if s.confidence == 'low' else '') }}">{{ s.confidence }}</span> {{ s.findings|length }} finding{{ "s" if s.findings|length != 1 }}</span>
        </div>
        <div class="table-scroll">
          {% if s.type == 'UserAssist' %}
          <table class="evidence-table">
            <thead><tr><th>Path</th><th>Run count</th><th>Timestamp</th></tr></thead>
            <tbody>
              {% for f in s.findings %}
              <tr>
                <td class="val">{{ f.path|wrap_path }}{% if f.harddiskvolume_note %}<br><span class="off">{{ f.harddiskvolume_note }}</span>{% endif %}</td>
                <td class="off">{{ f.run_count if f.run_count is not none else "—" }}</td>
                <td class="off">{{ f.timestamp|fmt_ts }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% elif s.type == 'MUICache' %}
          <table class="evidence-table">
            <thead><tr><th>Path</th><th>Detail</th><th>Registry key last updated</th></tr></thead>
            <tbody>
              {% for f in s.findings %}
              <tr>
                <td class="val">{{ f.path|wrap_path }}{% if f.harddiskvolume_note %}<br><span class="off">{{ f.harddiskvolume_note }}</span>{% endif %}</td>
                <td class="val">{{ f.description }}</td>
                <td class="off">{{ f.timestamp|fmt_ts }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          <p class="note" style="margin-top:6px;">This timestamp is the registry key's own last-write time, shared by every program recorded in this key — not a per-program run time.</p>
          {% else %}
          <table class="evidence-table">
            <thead><tr><th>Path</th>{% if s.type != 'ShimCache' %}<th>Detail</th>{% endif %}<th>Timestamp</th></tr></thead>
            <tbody>
              {% for f in s.findings %}
              <tr>
                <td class="val">{{ f.path|wrap_path }}{% if f.harddiskvolume_note %}<br><span class="off">{{ f.harddiskvolume_note }}</span>{% endif %}</td>
                {# A ShimCache description only repeats the path. #}
                {% if s.type != 'ShimCache' %}
                <td class="val">
                  {% if s.type == 'Amcache' %}sha1={{ f.sha1 or "—" }}, size={{ f.size or "—" }}
                  {% else %}{{ f.description }}
                  {% endif %}
                </td>
                {% endif %}
                <td class="off">{{ f.timestamp|fmt_ts }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </details>
    {% else %}
    <p class="note">No Tor-related registry artifacts found in the provided hives.</p>
    {% endif %}
  </section>
  {% endif %}

  {% if disk %}
  <div class="band">
    <div class="eyebrow">Module B</div>
    <h2>Disk — Tor Browser profile, Tor daemon &amp; downloaded files</h2>
    <dl class="meta-grid" style="margin-bottom:32px;">
      <dt>Sources analyzed</dt><dd>{{ disk.supplied|join(", ") }}</dd>
      {% if disk.profile %}
      <dt>Profile integrity</dt>
      <dd>{% if disk.profile.integrity.manifest_status == 'verified' %}<span class="flag-ok">✓ {{ disk.profile.integrity.hashed_files }} files verified against acquisition manifest</span>{% else %}<span class="flag-warn">⚠ No acquisition manifest — {{ disk.profile.integrity.hashed_files }} files hashed at analysis time only</span>{% endif %}{% if disk.profile.integrity.source_unchanged %} · source unchanged after analysis{% endif %}</dd>
      {% endif %}
      {% if disk.daemon %}
      <dt>Daemon dir integrity</dt>
      <dd>{% if disk.daemon.integrity.manifest_status == 'verified' %}<span class="flag-ok">✓ {{ disk.daemon.integrity.hashed_files }} files verified against acquisition manifest</span>{% else %}<span class="flag-warn">⚠ No acquisition manifest — {{ disk.daemon.integrity.hashed_files }} files hashed at analysis time only</span>{% endif %}{% if disk.daemon.integrity.source_unchanged %} · source unchanged after analysis{% endif %}</dd>
      {% endif %}
      {% if disk.downloads %}
      <dt>Volume scanned</dt><dd>{{ disk.downloads.volume_root }}{% if disk.downloads.live_scan %} (live scan on the target at acquisition){% endif %} — {{ "{:,}".format(disk.downloads.files_walked) }} files walked in {{ disk.downloads.scan_seconds }}s</dd>
      {% endif %}
    </dl>
  </div>

  {% if disk.errors %}
  <section>
    <div class="callout">
      <strong>Sections that failed:</strong> everything below comes from the sources that parsed cleanly.
      <ul style="margin:8px 0 0; padding-left:18px;">
        {% for name, err in disk.errors.items() %}
        <li class="mono" style="font-size:12px;">{{ name }}: {{ err }}</li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% if disk.daemon %}
  <section>
    <div class="section-head"><h2>Tor daemon activity</h2><span class="count">from <span class="mono">Data/Tor</span> — persisted across restarts, outside private-browsing scope</span></div>
    <dl class="meta-grid" style="margin-bottom:18px;">
      <dt>Tor version</dt><dd>{{ disk.daemon.tor_version or "—" }}</dd>
      <dt>Daemon started</dt><dd>{{ disk.daemon.daemon_start or "— (no lock file)" }}</dd>
      <dt>State last written</dt><dd>{{ disk.daemon.state_written or "—" }}{% if disk.daemon.guest_local_written %} <span style="color:var(--ink-muted)">(guest clock: {{ disk.daemon.guest_local_written }}{% if disk.daemon.guest_utc_offset_hours is not none %}, UTC{{ "%+g"|format(disk.daemon.guest_utc_offset_hours) }}h{% endif %})</span>{% endif %}</dd>
      {% if disk.daemon.minutes_since_user_activity is not none %}
      <dt>Idle at last write</dt><dd>{{ disk.daemon.minutes_since_user_activity }} min since user activity{% if disk.daemon.dormant %} · dormant={{ disk.daemon.dormant }}{% endif %}</dd>
      {% endif %}
      <dt>Circuits built</dt><dd>{{ disk.daemon.circuits_built or "—" }}{% if disk.daemon.histogram_consistent is false %} <span class="flag-warn">⚠ build-time histogram does not sum to this — state file truncated or edited</span>{% endif %}</dd>
      {% if disk.daemon.consensus %}
      <dt>Consensus</dt><dd>valid {{ disk.daemon.consensus.valid_after }} → {{ disk.daemon.consensus.valid_until }} <span style="color:var(--ink-muted)">(authority-signed; independent of the guest clock)</span></dd>
      {% endif %}
    </dl>
    <div class="section-head"><h3 style="font-size:15px; font-weight:600;">Entry guards that carried traffic</h3><span class="count">{{ disk.daemon.guards_used|length }} of {{ disk.daemon.guards_sampled }} sampled</span></div>
    {% if disk.daemon.guards_used %}
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Nickname</th><th>RSA id</th><th>Confirmed</th><th>Uses ok/tried</th><th>Circuits ok/tried</th></tr></thead>
        <tbody>
          {% for g in disk.daemon.guards_used %}
          <tr><td class="val">{{ g.nickname }}</td><td class="off">{{ g.rsa_id }}</td><td class="off">{{ g.confirmed_on or "—" }}</td><td class="mono">{{ g.use }}</td><td class="mono">{{ g.circuits }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="note">No guard has a recorded use — the daemon may never have built a working circuit.</p>
    {% endif %}
    {% if disk.daemon.credentials %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">Client-auth credentials</h3><span class="count">configuration, not proof of a visit</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Onion address</th><th>File</th><th>Modified</th><th>SHA-256</th></tr></thead>
        <tbody>
          {% for c in disk.daemon.credentials %}
          <tr><td class="val">{{ c.onion_address }}</td><td class="val">{{ c.filename }}</td><td class="off">{{ c.modified or "—" }}</td><td class="off">{{ c.sha256[:12] ~ "…" if c.sha256 else "—" }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if disk.daemon.ignored_auth_files %}
    <p class="note" style="margin-top:8px;">Ignored by tor (wrong extension): <span class="mono">{{ disk.daemon.ignored_auth_files|join(", ") }}</span></p>
    {% endif %}
    {% endif %}
  </section>
  {% endif %}

  {% if disk.downloads %}
  <section>
    <div class="section-head"><h2>Internet-origin files</h2><span class="count">{{ disk.downloads.inside }} created in the Tor window, of {{ disk.downloads.total }} found {{ disk.downloads.scope }}</span></div>
    {% if disk.downloads.hits %}
    <div class="ribbon">
      <strong>Network origin and timing, not the source site.</strong> Windows tags every file a browser saves from the network with a <span class="mono">Zone.Identifier</span> stream; locally created or USB/ISO-copied files never carry one. Tor Browser deliberately omits the <span class="mono">HostUrl</span>/<span class="mono">ReferrerUrl</span> fields other browsers write there, so the originating address is not recoverable from the file. Only the last Tor session's window is reconstructable from daemon artifacts.
    </div>
    {% endif %}
    {% if disk.downloads.skipped_folders or disk.downloads.mft_zone_streams %}
    <p class="note">
      {% if disk.downloads.skipped_folders %}<strong>Coverage:</strong> the live scan checked {{ "{:,}".format(disk.downloads.files_walked) }} files on {{ disk.downloads.volume_root }} and skips {% for f in disk.downloads.skipped_folders %}<span class="mono">{{ f }}</span>{{ ", " if not loop.last }}{% endfor %} folders, so a file in one of those is not counted here.{% endif %}
      {% if disk.downloads.mft_zone_streams %} The exported <span class="mono">$MFT</span>, which lists every file on its volume including deleted ones, independently records {{ disk.downloads.mft_zone_streams.total }} file{{ "s" if disk.downloads.mft_zone_streams.total != 1 }} with a <span class="mono">Zone.Identifier</span> stream{% if disk.downloads.mft_zone_streams.deleted %}, {{ disk.downloads.mft_zone_streams.deleted }} of them deleted{% endif %}.{% endif %}
    </p>
    {% endif %}
    {% if not disk.downloads.hits and disk.downloads.window %}
    {# Nothing to correlate: the window is already in "Tor daemon activity". #}
    {% elif disk.downloads.window %}
    <p class="note" style="margin-bottom:12px;">Tor daemon window used for correlation: <span class="mono">{{ disk.downloads.window.start }}</span> → <span class="mono">{{ disk.downloads.window.end }}</span>{% if disk.downloads.window.end_basis %} (end: {{ disk.downloads.window.end_basis }}){% endif %}.</p>
    {% elif 'tor_daemon' in disk.supplied %}
    <p class="note" style="margin-bottom:12px;">No daemon window could be derived (missing <span class="mono">lock</span> or <span class="mono">state</span>) — no files are listed because none can be correlated.</p>
    {% else %}
    <p class="note" style="margin-bottom:12px;">Supply <span class="mono">--tor-dir</span> alongside <span class="mono">--disk-root</span> to correlate these against the Tor daemon's session window.</p>
    {% endif %}
    {% if disk.downloads.hits %}
    <p class="note" style="margin-bottom:8px;">Only files created while the Tor daemon was running are listed; the other {{ disk.downloads.total - disk.downloads.inside }} marked file{{ "s" if disk.downloads.total - disk.downloads.inside != 1 }} (ordinary browser downloads and extracted archives) are omitted here and kept in <span class="mono">findings.json</span>.</p>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Path on volume</th><th>Created (NTFS)</th><th>Tor running?</th><th>Zone</th><th>Size</th><th>SHA-256</th></tr></thead>
        <tbody>
          {% for h in disk.downloads.hits %}
          <tr>
            <td class="val">{{ h.path }}{% if h.recycled %}<br><span class="flag-warn">⚠ In the Recycle Bin</span> <span class="off">— originally {{ h.recycled.original_path or "unknown (no $I record)" }}{% if h.recycled.deleted %}, deleted {{ h.recycled.deleted }}{% endif %}</span>{% endif %}{% if h.host_url or h.referrer_url %}<br><span class="off">host={{ h.host_url or "—" }} referrer={{ h.referrer_url or "—" }}</span>{% endif %}</td>
            <td class="off">{{ h.created or h.modified or "—" }}{% if not h.created %}<br>(mtime; no creation time){% endif %}</td>
            <td>{% if h.within_window is true %}<span class="chip high">yes</span>{% elif h.within_window is false %}<span class="chip low">no</span>{% else %}<span class="chip">unknown</span>{% endif %}</td>
            <td class="mono">{{ h.zone_id if h.zone_id is not none else "—" }}</td>
            <td class="off">{{ "{:,}".format(h.size) }}</td>
            <td class="off">{{ h.sha256[:12] }}…</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if disk.downloads.xattr_support is false %}
    <p class="note" style="margin-top:8px;"><span class="flag-warn">⚠</span> Volume not mounted through ntfs-3g — NTFS creation times unavailable, modification times shown instead.</p>
    {% endif %}
    {% elif disk.downloads.total %}
    <p class="note">{{ disk.downloads.total }} file{{ "s" if disk.downloads.total != 1 }} carry a <span class="mono">Zone.Identifier</span> stream, but none {% if disk.downloads.window %}was created while the Tor daemon was running{% else %}could be correlated to a Tor session{% endif %}; the list is kept in <span class="mono">findings.json</span>.</p>
    {% else %}
    <p class="note">No file on the volume carries a <span class="mono">Zone.Identifier</span> stream.{% if disk.downloads.xattr_support is none %} If the volume was not mounted through ntfs-3g the stream is invisible to this scan, so this is not proof that nothing was downloaded.{% endif %}</p>
    {% endif %}
  </section>
  {% endif %}

  {% if disk.residue %}
  <section>
    <div class="section-head"><h2>Memory residue on disk</h2><span class="count">pagefile, swapfile, hibernation file, crash dumps</span></div>
    {% set residue_errors = disk.residue.files|selectattr("error")|list %}
    {% if disk.residue.files and not disk.residue.addresses and not residue_errors %}
    <p class="note">No onion address in {% for f in disk.residue.files %}<span class="mono">{{ f.path }}</span>{{ ", " if not loop.last }}{% endfor %}.{% if not disk.residue.hibernation_present %} Tor Browser keeps visited addresses in memory only; Windows may never have paged them out.{% endif %}</p>
    {% else %}
    <div class="ribbon">
      <strong>The one disk route to a public onion address.</strong> Tor Browser and the tor daemon keep visited addresses in memory only; these files are where Windows itself writes memory to disk. A hit proves the string was in RAM at some point — not when, and not which process held it.{% if disk.residue.hibernation_present %} <span class="mono">hiberfil.sys</span> is compressed: its counts are a lower bound, and a Volatility3 hibernation-layer pass would read it fully.{% endif %}
    </div>
    {% if disk.residue.files %}
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>File</th><th>Kind</th><th>Size</th><th>Modified</th><th>Onion addrs</th><th>Credentials</th><th>Tor markers</th></tr></thead>
        <tbody>
          {% for f in disk.residue.files %}
          <tr>
            <td class="val">{{ f.path }}{% if f.compressed %}<br><span class="off">compressed — lower bound</span>{% endif %}{% if f.error %}<br><span class="chip error">error</span> <span class="off">{{ f.error }}</span>{% endif %}</td>
            <td class="mono">{{ f.kind.replace('_', ' ') }}</td>
            <td class="off">{{ "{:,}".format(f.size) }}</td>
            <td class="off">{{ f.modified or "—" }}</td>
            <td class="mono">{{ f.onion_count }}{% if f.invalid_onion_count %}<br><span class="off">+{{ f.invalid_onion_count }} matched the pattern but {{ "is not a valid v3 address" if f.invalid_onion_count == 1 else "are not valid v3 addresses" }} (e.g. the retired 16-character v2 form, or a failed checksum) &mdash; most likely random text</span>{% endif %}</td>
            <td class="mono">{{ f.credential_count }}</td>
            <td class="off">{{ f.markers|join(", ") if f.markers else "—" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if disk.residue.addresses %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">Onion addresses recovered from memory residue</h3><span class="count">{{ disk.residue.addresses|length }}</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Address</th><th>Occurrences</th><th>In</th></tr></thead>
        <tbody>
          {% for a in disk.residue.addresses %}
          <tr><td class="val">{{ a.address }}</td><td class="mono">{{ a.occurrences }}</td><td class="val">{{ a.files|join(", ") }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="note" style="margin-top:12px;">No onion address in any of these files. With enough RAM and no hibernation, Windows may never have paged Tor Browser out — a modified time older than the Tor session (see above) means the pagefile was not even written during it.</p>
    {% endif %}
    {% else %}
    <p class="note">No pagefile, swapfile, hibernation file or crash dump on this volume.</p>
    {% endif %}
    {% endif %}
  </section>
  {% endif %}

  {% if disk.ntfs or disk.notes.ntfs %}
  <section>
    <div class="section-head"><h2>NTFS metadata</h2><span class="count">$MFT records and the $UsnJrnl change journal</span></div>
    {% if disk.notes.ntfs %}
    <p class="note"><span class="flag-warn">⚠</span> Not analyzed — {{ disk.notes.ntfs }}.</p>
    {% else %}
    {% if disk.ntfs.addresses or disk.ntfs.downloads or disk.ntfs.deleted_downloads or disk.ntfs.deleted_tor_files %}
    <div class="ribbon">
      <strong>Written by the filesystem, not by Tor Browser.</strong> The MFT keeps names, timestamps and small contents of deleted files until their record is reused; the change journal logs every create, write, rename and delete by name. Both outlive the files, so a client-auth credential the user later removed, or a download later deleted, can still be named here.
    </div>
    {% endif %}
    <dl class="meta-grid" style="margin-bottom:18px;">
      <dt>$MFT</dt><dd>{% if disk.ntfs.mft_available %}{{ "{:,}".format(disk.ntfs.mft_records) }} named records{% else %}— not available{% endif %}</dd>
      <dt>$UsnJrnl</dt><dd>{% if disk.ntfs.usn_available %}{{ "{:,}".format(disk.ntfs.usn_records) }} records, {{ disk.ntfs.journal_first or "?" }} → {{ disk.ntfs.journal_last or "?" }}{% else %}— not available{% endif %}</dd>
      {% if disk.ntfs.window %}
      <dt>Tor file activity</dt><dd>{{ disk.ntfs.window.events }} journal events on Tor Browser/daemon files, {{ disk.ntfs.window.first }} → {{ disk.ntfs.window.last }}</dd>
      {% endif %}
    </dl>
    {% if disk.ntfs.addresses %}
    <div class="section-head"><h3 style="font-size:15px; font-weight:600;">Onion addresses in filesystem metadata</h3><span class="count">{{ disk.ntfs.addresses|length }}</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Address</th><th>Recorded in</th><th>Where</th><th>File status</th></tr></thead>
        <tbody>
          {% for a in disk.ntfs.addresses %}
          <tr><td class="val">{{ a.address }}</td><td class="mono">{{ a.sources|join(", ") }}</td><td class="val">{{ a.paths|join("; ") }}</td><td>{% if a.deleted %}<span class="chip low">deleted</span>{% elif a.filename_evidence %}<span class="chip ok">present</span>{% else %}<span class="chip">file content</span>{% endif %}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if disk.ntfs.resident_credentials %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">Client-auth credentials recovered from the MFT</h3><span class="count">{{ disk.ntfs.resident_credentials|length }} — file small enough to be stored inside its MFT record</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Address</th><th>File</th><th>MFT record</th><th>Created (NTFS)</th><th>File status</th></tr></thead>
        <tbody>
          {% for c in disk.ntfs.resident_credentials %}
          <tr><td class="val">{{ c.address }}</td><td class="val">{{ c.path }}{% if not c.loadable_by_tor %} <span class="chip low">not loadable by tor</span>{% endif %}</td><td class="mono">{{ c.record }}</td><td class="mono">{{ c.created or "—" }}</td><td>{% if c.deleted %}<span class="chip low">deleted</span>{% else %}<span class="chip ok">present</span>{% endif %}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="note" style="margin-top:8px;">The full credential (address and key) survives in the MFT record until Windows reuses that record, even after the file or the whole Tor Browser folder is deleted. A credential shows the hidden service was configured for access; on its own it does not prove a visit. Tor only loads files whose name ends exactly in <span class="mono">.auth_private</span>.</p>
    {% endif %}
    {% if disk.ntfs.resident_onion_files %}
    <p class="note" style="margin-top:8px;">Addresses found inside small files stored in the MFT itself: {% for r in disk.ntfs.resident_onion_files %}<span class="mono">{{ r.path }}</span>{{ " (deleted)" if r.deleted }}{{ "; " if not loop.last }}{% endfor %} — check whether these are the examiner's own transfer files before counting them as browsing evidence.</p>
    {% endif %}
    {% else %}
    <p class="note">No onion address appears in any filename, journal entry or MFT-resident file content.</p>
    {% endif %}
    {% if disk.ntfs.downloads %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">Downloads reconstructed from the change journal</h3><span class="count">{{ disk.ntfs.downloads|length }} — temp-file naming identifies the browser family</span></div>
    <div class="callout">
      <strong>Browser attribution.</strong> Firefox — and therefore Tor Browser — saves a download as <span class="mono">&lt;8 random chars&gt;.&lt;ext&gt;.part</span>, then renames it to the final name and stamps <span class="mono">Zone.Identifier</span>; Chromium uses <span class="mono">.crdownload</span>, legacy Edge/IE <span class="mono">.partial</span>. The journal records that sequence by name, so it survives the file being deleted and it names the family that wrote it. Attribution to Tor Browser specifically holds when it is the only Firefox-family browser on the machine.
    </div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Path</th><th>Started</th><th>Completed</th><th>Browser family</th><th>Tor running?</th><th>Zone stamped</th><th>Deleted</th></tr></thead>
        <tbody>
          {% for d in disk.ntfs.downloads %}
          <tr>
            <td class="val">{{ d.path }}<br><span class="off">via {{ d.temp_name }}</span></td>
            <td class="off">{{ d.started or "—" }}</td>
            <td class="off">{{ d.completed or "—" }}</td>
            <td class="mono">{{ d.browser_family.replace('_', ' ') }}</td>
            <td>{% if d.within_window is true %}<span class="chip high">yes</span>{% elif d.within_window is false %}<span class="chip low">no</span>{% else %}<span class="chip">unknown</span>{% endif %}</td>
            <td class="mono">{{ "yes" if d.zone_stamped else "—" }}</td>
            <td class="off">{{ d.deleted or "—" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if disk.ntfs.deleted_downloads %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">Deleted internet-origin files</h3><span class="count">Zone.Identifier survives in the MFT record</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Path</th><th>Created</th><th>Zone</th><th>MFT record</th></tr></thead>
        <tbody>
          {% for d in disk.ntfs.deleted_downloads %}
          <tr><td class="val">{{ d.path }}</td><td class="off">{{ d.created or "—" }}</td><td class="mono">{{ d.zone_id if d.zone_id is not none else "—" }}</td><td class="mono">{{ d.record }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if disk.ntfs.deleted_tor_files %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">Deleted Tor-related files</h3><span class="count">{{ disk.ntfs.deleted_tor_files|length }} — MFT record not in use, name retained</span></div>
    {% for d in disk.ntfs.deleted_tor_files[:200] %}
    <div class="appendix-row"><span class="val">{{ d.path }}</span><span class="why">{{ d.modified or "—" }}</span></div>
    {% endfor %}
    {% endif %}
    {% if disk.ntfs.event_files %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">Tor files changed in the journal</h3><span class="count">{{ disk.ntfs.event_files|length }} file{{ "s" if disk.ntfs.event_files|length != 1 }}, {{ disk.ntfs.events|length }} event{{ "s" if disk.ntfs.events|length != 1 }}{% if disk.ntfs.events_total > disk.ntfs.events|length %} (most recent of {{ disk.ntfs.events_total }}){% endif %}; each event is in findings.json</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>File and actions</th><th>Events</th><th>First</th><th>Last</th></tr></thead>
        <tbody>
          {% for f in disk.ntfs.event_files %}
          <tr><td class="val">{{ f.path|wrap_path }}<div class="note" style="font-size:11.5px;">{{ f.actions|join(", ") }}</div></td><td class="mono">{{ f.count }}</td><td class="off">{{ f.first or "—" }}</td><td class="off">{{ f.last or "—" }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% endif %}
  </section>
  {% endif %}

  {% if disk.profile %}
  <section>
    <div class="section-head"><h2>Browser profile</h2><span class="count">{{ disk.profile.places_rows }} places rows, {{ disk.profile.default_entries }} shipped defaults, {{ disk.profile.history_visits }} recorded visits</span></div>
    {% if disk.profile.errors %}
    <div class="callout"><strong>Unreadable:</strong> {% for name, err in disk.profile.errors.items() %}<span class="mono">{{ name }}</span> — {{ err }}{{ "; " if not loop.last }}{% endfor %}. Absence below is not established for these files.</div>
    {% endif %}
    {% if disk.profile.inert %}
    <div class="callout"><strong>Expected inert profile.</strong> Tor Browser runs in permanent private browsing: <span class="mono">places.sqlite</span> keeps only the shipped Tor Project bookmarks and never records visits, downloads or cookies. An empty table here is the normal state after real use — the daemon and volume sections above carry the activity evidence.</div>
    {% endif %}
    {% if disk.profile.history %}
    <div class="section-head"><h3 style="font-size:15px; font-weight:600;">Visited pages</h3><span class="count">excluding shipped defaults</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>URL</th><th>Title</th><th>Visits</th><th>Typed</th><th>Last visit</th></tr></thead>
        <tbody>
          {% for h in disk.profile.history %}
          <tr><td class="val">{{ h.url }}</td><td class="val">{{ h.title or "—" }}</td><td class="mono">{{ h.visit_count }}</td><td class="mono">{{ "yes" if h.typed else "—" }}</td><td class="off">{{ h.last_visit or "—" }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if disk.profile.download_records %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">Download records</h3><span class="count">from places.sqlite annotations</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Source URL</th><th>Saved to</th><th>Added</th></tr></thead>
        <tbody>
          {% for d in disk.profile.download_records %}
          <tr><td class="val">{{ d.source_url }}</td><td class="val">{{ d.destination }}</td><td class="off">{{ d.added or "—" }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if disk.profile.cookies %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">Cookies</h3><span class="count">{{ disk.profile.cookies|length }}</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Host</th><th>Name</th><th>Created</th><th>Last accessed</th><th>Expires</th></tr></thead>
        <tbody>
          {% for c in disk.profile.cookies %}
          <tr><td class="val">{{ c.host }}</td><td class="val">{{ c.name }}</td><td class="off">{{ c.created or "—" }}</td><td class="off">{{ c.last_accessed or "—" }}</td><td class="off">{{ c.expires or "—" }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if disk.profile.bookmarks %}
    <div class="section-head" style="margin-top:22px;"><h3 style="font-size:15px; font-weight:600;">User bookmarks</h3><span class="count">from bookmark backups, excluding shipped defaults</span></div>
    <div class="path-list">
      {% for b in disk.profile.bookmarks %}<span class="path-pill">{{ b.uri }}{% if b.title %} <span style="color:var(--ink-muted)">— {{ b.title }}</span>{% endif %}</span>{% endfor %}
    </div>
    {% endif %}
    {% if disk.profile.favicon_pages %}
    <p class="note" style="margin-top:14px;">Favicon cache also references: <span class="mono">{{ disk.profile.favicon_pages|join(", ") }}</span></p>
    {% endif %}
  </section>
  {% endif %}

  {% if disk.carve %}
  <section>
    <div class="section-head"><h2>Raw image carve</h2><span class="count">byte-level scan incl. unallocated space</span></div>
    <dl class="meta-grid" style="margin-bottom:14px;">
      <dt>Image</dt><dd>{{ disk.carve.image }}</dd>
      <dt>SHA-256</dt><dd>{{ disk.carve.image_sha256 }}</dd>
    </dl>
    {% if disk.carve.addresses %}
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Onion address</th><th>Occurrences</th><th>First offsets</th></tr></thead>
        <tbody>
          {% for a in disk.carve.addresses %}
          <tr><td class="val">{{ a.address }}</td><td class="mono">{{ a.occurrences }}</td><td class="off">{{ a.first_offsets|join(", ") }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="note">No onion addresses carved from the image.</p>
    {% endif %}
    {% if disk.carve.credentials %}
    <p class="note" style="margin-top:8px;">Client-auth credential bytes found for: <span class="mono">{{ disk.carve.credentials|join(", ") }}</span> — presence alone does not prove a visit.</p>
    {% endif %}
  </section>
  {% endif %}
  {% endif %}

  {% if memory %}
  {% set d = memory.details %}
  <div class="band">
    <div class="eyebrow">Module C</div>
    <h2>Memory — Tor Browser process dump</h2>
    <dl class="meta-grid" style="margin-bottom:32px;">
      <dt>Dump file</dt><dd>{{ d.dump.path.split('/')[-1].split('\\')[-1] }}</dd>
      <dt>Size</dt><dd>{{ "{:,}".format(d.dump.size_bytes) }} bytes ({{ "%.1f"|format(d.dump.size_bytes / 1048576) }} MiB)</dd>
      <dt>SHA-256</dt><dd>{{ d.dump.sha256 }}</dd>
      <dt>Integrity</dt>
      <dd>
        {% if d.dump.integrity_verified == true %}<span class="flag-ok">✓ Verified against .sha256 sidecar</span>
        {% else %}<span class="flag-warn">⚠ Unverified — no .sha256 sidecar alongside this copy</span>
        {% endif %}
      </dd>
      <dt>Target onion</dt><dd>{{ d.targeting.onion or "— not supplied" }}</dd>
      <dt>Target host</dt><dd>{{ d.targeting.host or "— not supplied" }}</dd>
      <dt>Username</dt><dd>{{ d.targeting.username or "— not supplied this run" }}</dd>
    </dl>
  </div>

  {% if d.host_anchoring.no_target %}
  {% set held = d.host_anchoring.unanchored.values()|map(attribute="count")|sum %}
  <section>
    <div class="callout">
      <strong>No target was given, so nothing in this memory section is attributed to Tor Browser.</strong>
      A full-memory image holds every process's memory &mdash; antivirus signatures, scripts and other programs' data &mdash; and without an <span class="mono">--onion</span> or <span class="mono">--host</span> there is nothing to tie a credential, cookie, search or download path to the browser. The {{ "{:,}".format(held) }} such match{{ "es" if held != 1 }} found are kept in <span class="mono">findings.json</span> as unattributed observations (<span class="mono">host_anchoring.unanchored</span>), not reported as findings.
      {% if d.targeting_suggestions %}
      The onion address mentioned most often in memory is <span class="mono">{{ d.targeting_suggestions[0].onion }}</span> ({{ d.targeting_suggestions[0].hit_count }}&times;). If it is the site under investigation, run the analysis again with <span class="mono">--onion {{ d.targeting_suggestions[0].onion }}</span> &mdash; Tor Browser's own built-in services can also appear in this list, so check it first.
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if d.targeting_suggestions %}
  <section>
    <div class="callout">
      <strong>Heads up:</strong> onion address(es) seen repeatedly in memory but not covered by <span class="mono">--onion</span>/<span class="mono">--host</span> (Tor Browser's own bundled default services also land here — check before assuming a missed target):
      <ul style="margin:8px 0 0; padding-left:18px;">
        {% for s in d.targeting_suggestions %}
        <li class="mono" style="font-size:12px;">{{ s.onion }} (seen {{ s.hit_count }}×)</li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% if memory.session_cookies %}
  <section>
    <div class="section-head"><h2>Session &amp; cookies</h2><span class="count">{{ memory.session_cookies|length }} unique, high-confidence</span></div>
    {% if memory.session_cookies %}
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Name</th><th>Value</th><th>First offset</th><th>Occ.</th></tr></thead>
        <tbody>
          {% for c in memory.session_cookies %}
          <tr>
            <td class="val">{{ c.name }}</td>
            <td class="val">{{ c.value }}{% if c.decoded_payload %}<br><span style="color:var(--ink-muted)">↳ decodes to {{ c.decoded_payload }}</span>{% endif %}</td>
            <td class="off">{{ c.offset }}</td>
            <td class="mono">{{ c.occurrences }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="note">No high-confidence session/cookie values recovered.</p>
    {% endif %}
  </section>
  {% endif %}

  {% if d.key_findings.credentials %}
  <section>
    <div class="section-head"><h2>Credentials</h2><span class="count">{{ d.key_findings.credentials|length }} unique, high-confidence</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Field</th><th>Value</th><th>Shape</th><th>First offset</th><th>Occ.</th></tr></thead>
        <tbody>
          {% for c in d.key_findings.credentials %}
          <tr><td class="val">{{ c.field }}</td><td class="val">{{ c.value }}</td><td class="mono">{{ c.shape }}</td><td class="off">{{ c.offset }}</td><td class="mono">{{ c.occurrences }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  {% if memory.site_map %}
  <section>
    <div class="section-head"><h2>Site map</h2><span class="count">{{ memory.site_map|length }} distinct paths</span></div>
    <div class="path-list">
      {% for p in memory.site_map %}
      <span class="path-pill{{ ' odd' if p in memory.near_duplicates }}">{{ p }}</span>
      {% endfor %}
    </div>
    {% if memory.near_duplicates %}
    <p class="note" style="margin-top:10px;">
      {% for p, close in memory.near_duplicates.items() %}
      <strong style="color:var(--noise)">{{ p }}</strong> closely resembles {{ close|join(", ") }} — possible typo, stray keystroke, or manual endpoint probing.<br>
      {% endfor %}
    </p>
    {% endif %}
    {% if memory.assets %}
    <p class="note" style="margin-top:10px;">+ {{ memory.assets|length }} automatic asset request{{ "s" if memory.assets|length != 1 }} (<span class="mono">{{ memory.assets|join(", ") }}</span>) — page-load traffic, not user actions; kept out of the sequence below.</p>
    {% endif %}
  </section>
  {% endif %}

  {% if memory.downloads.matched %}
  <section>
    <div class="section-head"><h2>Local downloads</h2><span class="count">{{ memory.downloads.matched|length }} matched to a target-site path</span></div>
    {% if memory.downloads.matched %}
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>File</th><th>Matches site endpoint</th></tr></thead>
        <tbody>
          {% for dl in memory.downloads.matched %}
          <tr><td class="val">{{ dl.value }}</td><td class="val">{{ dl.matched_endpoint }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="note">No downloads correlate to a target-site path.</p>
    {% endif %}
    {% if memory.downloads.unmatched %}
    <details class="appendix" style="margin-top:14px;">
      <summary>Show {{ memory.downloads.unmatched|length }} other download{{ "s" if memory.downloads.unmatched|length != 1 }} seen on this machine — not correlated to the target site</summary>
      <div class="appendix-body">
        <p class="note" style="margin-bottom:10px;">This is a full-memory image: a <span class="mono">Users\*\Downloads\</span> path anywhere on the machine — any user account, any application, unrelated installers — shows up here, not just this investigation's target. None of these correlate to a recovered target-site path; treat them as machine-wide context, not evidence tied to the target.</p>
        {% for dl in memory.downloads.unmatched %}
        <div class="appendix-row"><span class="val">{{ dl.value }}</span></div>
        {% endfor %}
      </div>
    </details>
    {% endif %}
  </section>
  {% endif %}

  {% if memory.search_terms %}
  <section>
    <div class="section-head"><h2>Search / typed terms</h2><span class="count">by occurrence count</span></div>
    {% if memory.search_terms %}
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Term</th><th>Occurrences</th></tr></thead>
        <tbody>
          {% for t in memory.search_terms %}
          <tr><td class="val">{{ t.value }}{% if t.matches_username %}<span class="chip high" style="margin-left:6px;">matches --username</span>{% endif %}</td><td class="mono">{{ t.count }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="note">No non-template search terms recovered.</p>
    {% endif %}
  </section>
  {% endif %}

  {% if memory.events %}
  <section>
    <div class="section-head"><h2>Reconstructed activity sequence</h2><span class="count">{{ memory.events|length }} events, offset-ordered</span></div>
    <div class="ribbon"><strong>Not a verified timeline.</strong> {{ d.timeline.disclaimer }}</div>
    {% if memory.events %}
    <ol class="sequence">
      {% for e in memory.events %}
      <li>
        <div><span class="seq-type">{{ e.type }}</span>{{ e.detail }}{% if e.clustered_with_prev %}<span class="seq-flag">‡ clustered</span>{% endif %}{% if e.far_from_start %}<span class="seq-flag">† storage-region caveat</span>{% endif %}</div>
        <div class="seq-off">{{ e.offset }}</div>
      </li>
      {% endfor %}
    </ol>
    {% if memory.any_clustered %}
    <div class="callout">
      <strong>‡ Clustered events:</strong> events flagged with ‡ sit within {{ "{:,}".format(memory.cluster_gap_bytes) }} bytes of the previous one — tight enough to more likely be one rendered page's set of links (e.g. a dashboard listing everything at once) than separate sequential navigations. Treat clustered runs as "seen together," not necessarily "done in that exact order."
    </div>
    {% endif %}
    {% if memory.any_far_from_start %}
    <div class="callout">
      <strong>† Storage-region caveat:</strong> events flagged with † sit far past the sequence's typical spacing from the earliest event. Cookie/session and download-manager data live in their own memory regions, separate from rendered page content — a late offset here reflects where that data happens to sit in memory, not when it was created. Don't read these as "happened last."
    </div>
    {% endif %}
    {% else %}
    <p class="note">No timeline events recovered.</p>
    {% endif %}
  </section>
  {% endif %}

  <section>
    <div class="section-head">
      <h2>Process &amp; system context (Volatility3)</h2>
      <span class="count">independent structural pass — never merged with string-carver evidence above</span>
    </div>
    <div class="ribbon">
      <strong>A second, independent method, not a second string carver.</strong> Everything below comes from
      parsing kernel data structures (process pool allocations, network/file/registry state), not from
      scanning bytes for text patterns — see each row's <span class="mono">source</span> tag. It can confirm
      <em>which process</em> and <em>when</em> in ways raw string carving can't, but needs kernel symbols
      matching the imaged OS build to run at all.
    </div>
    {% if memory.volatility3.status == 'skipped' %}
    <p class="note">Not run this pass — {{ memory.volatility3.message }}.</p>
    {% elif memory.volatility3.status == 'error' %}
    <p class="note"><span class="chip error">error</span> Volatility3 could not be invoked at all — {{ memory.volatility3.message }}</p>
    {% else %}
    {% if memory.volatility3.corroboration %}
    <div class="callout">
      <strong>Independent corroboration:</strong> the notes below point out where this structural pass and the
      string-carver evidence above happen to agree — a human-readable juxtaposition, not an automated score.
      <ul style="margin:8px 0 0; padding-left:18px;">
        {% for note in memory.volatility3.corroboration %}
        <li>{{ note }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
    {% set pa = memory.volatility3.process_activity %}
    {% if pa %}
    <div class="section-head" style="margin-top:22px;">
      <h3 style="font-size:15px; font-weight:600;">Tor Browser processes</h3>
      <span class="count">from windows.psscan, grouped by parent process</span>
    </div>
    {% if pa.groups %}
    <p class="note">{{ pa.process_count }} Tor Browser process{{ "es" if pa.process_count != 1 }} (firefox.exe / tor.exe) ran from {{ pa.first_start|fmt_ts }}{% if pa.still_running %}, and some were still running when the image was taken{% else %} to {{ pa.last_exit|fmt_ts }}{% endif %}, in {{ pa.groups|length }} group{{ "s" if pa.groups|length != 1 }} by parent process. A group is the set of processes one parent started: Tor Browser starts several per run and their parents have often exited, so a group is not necessarily one launch.</p>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Parent PID</th><th>Processes</th><th>First started</th><th>Last exited</th></tr></thead>
        <tbody>
          {% for g in pa.groups %}
          <tr>
            <td class="mono">{{ g.parent_pid }}</td>
            <td>{{ g.count }} &times; {{ g.names|join(", ") }}</td>
            <td class="off">{{ g.first_start|fmt_ts }}</td>
            <td class="off">{% if g.still_running %}still running at capture{% else %}{{ g.last_exit|fmt_ts }}{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% for note in memory.process_registry_notes %}
    <p class="note"><strong>Compared with the registry:</strong> {{ note }}</p>
    {% endfor %}
    {% if pa.clock_anomalies %}
    <div class="callout">
      <strong>Clock anomaly:</strong> {{ pa.clock_anomalies|length }} process{{ "es" if pa.clock_anomalies|length != 1 }} on this computer show{{ "s" if pa.clock_anomalies|length == 1 }} a creation time after this image was taken ({{ pa.capture_time|fmt_ts }}), which is impossible: the computer's clock was wrong when they started (for example before it synchronised its time). They are left out of the timing above; treat their timestamps as unreliable.
    </div>
    {% endif %}
    {% endif %}
    {% for p in memory.volatility3.plugins %}
    <div class="section-head" style="margin-top:22px;">
      <h3 style="font-size:15px; font-weight:600;">{{ p.label }}</h3>
      <span class="count mono">source: volatility3:{{ p.name }}</span>
    </div>
    {% if p.status == 'ok' %}
    {% if p.rows %}
    <div class="table-scroll">
      <table class="evidence-table">
        <thead>
          <tr>
            {% for col in p.rows[0].keys() if col != 'source' %}
            <th>{{ col }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in p.rows %}
          <tr>
            {% for col, val in row.items() if col != 'source' %}
            <td class="val">{{ val if val is not none else "—" }}</td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="note">{{ p.rows|length }} of {{ p.total_rows }} rows: {{ "distinct files in Tor Browser's data folder" if p.name.endswith("FileScan") else "Tor Browser processes only" }}{% if p.truncated %}, first {{ p.rows|length }} shown{% endif %}. Every row is in findings.json.</p>
    {% else %}
    <p class="note">No Tor Browser rows ({{ p.total_rows }} rows for other processes are in findings.json).</p>
    {% endif %}
    {% else %}
    <p class="note"><span class="chip error">error</span> {{ p.message }}</p>
    {% endif %}
    {% endfor %}
    {% endif %}
  </section>

  {# Noise counts stay in findings.json (details.unfiltered); not printed. #}
  {% endif %}

  {% for g in generic_modules %}
  <div class="band">
    <div class="eyebrow">{{ g.name }}</div>
    <h2>{{ g.name.replace('module_', '').replace('_', ' — ', 1)|title }}</h2>
  </div>
  <section>
    <p><span class="chip {{ g.status }}">{{ g.status.replace('_', ' ') }}</span>{% if g.message %} <span class="note">{{ g.message }}</span>{% endif %}</p>
    {% if g.artifacts %}
    <div class="section-head" style="margin-top:14px;"><h2 style="font-size:16px;">Artifacts</h2><span class="count">showing {{ g.artifacts|length }} of {{ g.total }}</span></div>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Type</th><th>Source</th><th>Description</th><th>SHA-256</th><th>Timestamp</th></tr></thead>
        <tbody>
          {% for a in g.artifacts %}
          <tr>
            <td class="mono">{{ a.artifact_type }}</td>
            <td class="val">{{ a.source }}</td>
            <td class="val">{{ a.description }}</td>
            <td class="off">{{ a.sha256[:12] ~ "…" if a.sha256 else "—" }}</td>
            <td class="off">{{ a.timestamp or "—" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% elif g.status == 'ok' %}
    <p class="note">Ran cleanly, no artifacts reported.</p>
    {% elif g.status == 'not_implemented' %}
    <p class="note">This module has no implementation yet — nothing from this evidence layer contributes to the case until it does.</p>
    {% elif g.status == 'skipped' %}
    <p class="note">No evidence was supplied for this module this run.</p>
    {% endif %}
  </section>
  {% endfor %}

  <div class="band">
    <div class="eyebrow">Reliability</div>
    <h2>Limitations and tool validation</h2>
  </div>
  <section>
    <div class="section-head"><h2>Limitations of this examination</h2><span class="count">what this run could not establish or check</span></div>
    {% if limitations %}
    <ul class="narrative-list">
      {% for line in limitations %}<li>{{ line }}</li>{% endfor %}
    </ul>
    {% else %}
    <p class="note">No limitations were recorded for this run.</p>
    {% endif %}
    {% if registry and registry.narrative.not_determined %}
    <p class="note" style="margin-top:8px;">See also "What we could not determine" in the registry section.</p>
    {% endif %}
  </section>

  <section>
    <div class="section-head"><h2>Tool validation</h2><span class="count">how well TRANCE recovered a known, scripted Tor Browser session</span></div>
    <p class="note">A scripted session on a control onion site (37 recorded actions, 12 decoys that were never touched) was run on a clean Windows 10 virtual machine and captured four ways. The table gives how many of the 37 actions TRANCE recovered, beside how many were present in the evidence at all (found by a plain text search of the same files).</p>
    <div class="table-scroll">
      <table class="evidence-table">
        <thead><tr><th>Capture</th><th>Present in evidence</th><th>Recovered by TRANCE</th></tr></thead>
        <tbody>
          <tr><td>Powered off, disk only</td><td>7 of 37</td><td>6 of 37</td></tr>
          <tr><td>Running, browser closed</td><td>8 of 37</td><td>7 of 37</td></tr>
          <tr><td>Running, browser open</td><td>37 of 37</td><td>37 of 37</td></tr>
          <tr><td>Negative control (no browsing)</td><td>0 of 37</td><td>no false findings of the session</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note" style="margin-top:10px;">Limits of this validation: one run per condition, so no measure of variation; the memory extractors were refined on the same browser-open capture they are scored on, so 37 of 37 is not an independent result; and the runs used a test site, not real-world services. Scored with TRANCE's analysis code as of commit 65eb932 using <span class="mono">scripts/score_run.py</span>. A result absent from this report is not proof the activity did not happen.</p>
  </section>

  <div class="band">
    <div class="eyebrow">Next steps</div>
    <h2>Recommendations<span class="chip interp">Interpretation</span></h2>
  </div>
  <section>
    <ul class="reco-list">
      {% if memory %}
      {% if memory.search_terms and not memory.details.targeting.username %}
      <li>Re-run with <span class="mono">--username &lt;candidate&gt;</span> to confirm which search term was the real login via the <span class="mono">matches_username</span> flag.</li>
      {% endif %}
      {% if memory.details.targeting_suggestions %}
      <li>Check the onion address(es) flagged in the memory section — re-run with <span class="mono">--onion</span> set to any that turn out to be a real missed target.</li>
      {% endif %}
      {% if (memory.session_cookies or memory.site_map) and not memory.details.key_findings.credentials %}
      <li>No plaintext credentials recovered from memory strings alone — for firmer proof of the login itself, correlate with server-side access logs or a disk-based artifact (browser saved-logins store, if enabled).</li>
      {% endif %}
      {% if memory.downloads.matched %}
      <li>If the source machine is still available, pull real filesystem MACB timestamps on the confirmed downloads — actual time data this memory-only view can't provide.</li>
      {% endif %}
      {% if memory.any_clustered or memory.any_far_from_start %}
      <li>Treat every ‡/† flag in the activity sequence as an investigative lead worth checking against another source, not as settled fact.</li>
      {% endif %}
      {% endif %}
      {% if disk %}
      {% if disk.downloads and disk.downloads.hits and not disk.downloads.window %}
      <li>Re-run with <span class="mono">--tor-dir</span> so the {{ disk.downloads.hits|length }} internet-origin file{{ "s" if disk.downloads.hits|length != 1 }} can be placed inside or outside the Tor daemon's session window.</li>
      {% endif %}
      {% if disk.downloads and disk.downloads.inside %}
      <li>{{ disk.downloads.inside }} internet-origin file{{ "s were" if disk.downloads.inside != 1 else " was" }} created while Tor was running. The file itself cannot name its source; confirm the originating site from memory (Module C download/site-map correlation) or server-side logs.</li>
      {% endif %}
      {% if disk.profile and disk.profile.inert and not disk.downloads %}
      <li>The profile is inert by design. Run with <span class="mono">--disk-root</span> on the mounted volume to find downloaded files anywhere on disk, and rely on the daemon section for session timing.</li>
      {% endif %}
      {% if disk.residue and not disk.residue.any_hits and not disk.residue.hibernation_present %}
      <li>No memory residue reached disk. A visited public onion service can only come from memory: acquire RAM live (Module C), or, for the post-hibernation scenario, hibernate the machine before imaging so <span class="mono">hiberfil.sys</span> captures it.</li>
      {% endif %}
      {% if disk.notes.ntfs %}
      <li>Remount the volume with <span class="mono">-o ro,show_sys_files,streams_interface=windows</span> so <span class="mono">$MFT</span> and <span class="mono">$UsnJrnl</span> can be parsed for deleted credential files, deleted downloads and a file-level activity timeline.</li>
      {% endif %}
      {% if not disk.daemon %}
      <li>Supply <span class="mono">--tor-dir</span> (<span class="mono">TorBrowser/Data/Tor</span>): the daemon directory is the one disk source that persists guard usage and session timing outside private-browsing scope.</li>
      {% endif %}
      {% endif %}
      {% for g in generic_modules if g.status != 'ok' %}
      <li><span class="mono">{{ g.name }}</span> did not contribute ({{ g.status.replace('_', ' ') }}){% if g.message %}: {{ g.message }}{% endif %}. Cross-layer correlation is incomplete until it does.</li>
      {% endfor %}
    </ul>
  </section>

  <div class="band">
    <div class="eyebrow">Summary</div>
    <h2>Summary of findings<span class="chip interp">Interpretation</span></h2>
    <p class="band-subtitle">One short account per layer of evidence; the sections above hold the detail.</p>
  </div>
  <section>
    {% for g in generic_modules if g.status != 'ok' %}
    <p class="note"><span class="mono">{{ g.name }}</span>: {{ g.status.replace('_', ' ') }}{% if g.message %} — {{ g.message }}{% endif %}.</p>
    {% endfor %}
    {% if registry %}
    <h3 style="font-size:15px; font-weight:600; margin-top:14px;">Registry</h3>
    <p>{{ registry.narrative.key_finding }}</p>
    {% endif %}
    {% if disk %}
    <h3 style="font-size:15px; font-weight:600; margin-top:14px;">Disk</h3>
    <ul class="reco-list">
      {% if disk.daemon %}
      {% if disk.daemon.daemon_start %}
      <li>The Tor daemon ran from {{ disk.daemon.daemon_start }} to at least {{ disk.daemon.state_written or disk.daemon.daemon_start }}; {{ disk.daemon.guards_used|length }} entry guard{{ "s" if disk.daemon.guards_used|length != 1 }} carried traffic and {{ disk.daemon.circuits_built or "an unknown number of" }} circuits were built.</li>
      {% else %}
      <li>Tor's data folder was examined, but there is no <span class="mono">lock</span> file, so when the daemon started is unknown.</li>
      {% endif %}
      {% if disk.daemon.credentials %}
      <li>{{ disk.daemon.credentials|length }} client-auth credential{{ "s" if disk.daemon.credentials|length != 1 }} name{{ "s" if disk.daemon.credentials|length == 1 }} a specific onion service: {{ disk.daemon.credentials|map(attribute="onion_address")|join(", ") }}.</li>
      {% endif %}
      {% endif %}
      {% if disk.downloads %}
      <li>{% if disk.downloads.total %}{{ disk.downloads.total }} internet-origin file{{ "s" if disk.downloads.total != 1 }} found {{ disk.downloads.scope }}{% if disk.downloads.window %}, {{ disk.downloads.inside }} created while Tor was running{% endif %}{% else %}No internet-origin file found {{ disk.downloads.scope }}{% endif %}.</li>
      {% endif %}
      {% if disk.residue %}
      <li>{% if disk.residue.any_hits %}{{ disk.residue.addresses|length }} onion address{{ "es" if disk.residue.addresses|length != 1 }} recovered from memory residue on disk: {{ disk.residue.addresses|map(attribute="address")|join(", ") }}.{% else %}No onion address in the memory residue on disk.{% endif %}</li>
      {% endif %}
      {% if disk.ntfs %}
      <li>{% if disk.ntfs.addresses %}{{ disk.ntfs.addresses|length }} onion address{{ "es" if disk.ntfs.addresses|length != 1 }} in filesystem metadata; {% endif %}{{ disk.ntfs.event_files|length }} Tor file{{ "s" if disk.ntfs.event_files|length != 1 }} changed in the journal, {{ disk.ntfs.deleted_tor_files|length }} deleted.</li>
      {% endif %}
      {% if disk.profile %}
      <li>{% if disk.profile.inert %}The browser profile holds no history, cookies or bookmarks beyond the shipped defaults, as expected with permanent private browsing.{% else %}The browser profile holds {{ disk.profile.history|length }} visited page{{ "s" if disk.profile.history|length != 1 }}, {{ disk.profile.cookies|length }} cookie{{ "s" if disk.profile.cookies|length != 1 }} and {{ disk.profile.bookmarks|length }} user bookmark{{ "s" if disk.profile.bookmarks|length != 1 }}; unusual for Tor Browser.{% endif %}</li>
      {% endif %}
    </ul>
    {% endif %}
    {% if memory %}
    {% set d = memory.details %}
    <h3 style="font-size:15px; font-weight:600; margin-top:14px;">Memory</h3>
    <ul class="reco-list">
      {% if d.host_anchoring.no_target %}
      <li>No target was given, so nothing in memory is attributed to Tor Browser{% if d.targeting_suggestions %}; the onion address seen most often is {{ d.targeting_suggestions[0].onion }}{% endif %}.</li>
      {% endif %}
      {% set pa = memory.volatility3.process_activity %}
      {% if pa and pa.groups %}
      <li>{{ pa.process_count }} Tor Browser process{{ "es" if pa.process_count != 1 }} ran from {{ pa.first_start|fmt_ts }}{% if pa.still_running %}, some still running at capture{% else %} to {{ pa.last_exit|fmt_ts }}{% endif %}.</li>
      {% endif %}
      {% set mem_found = [] %}
      {% set mem_empty = [] %}
      {% for one, many, none_label, value in [("session cookie", "session cookies", "session cookies", memory.session_cookies), ("credential", "credentials", "credentials", d.key_findings.credentials), ("site-map path", "site-map paths", "site map", memory.site_map), ("download from the target site", "downloads from the target site", "downloads from the target site", memory.downloads.matched), ("search term", "search terms", "search terms", memory.search_terms), ("activity-sequence event", "activity-sequence events", "activity sequence", memory.events)] %}{% set _ = (mem_found if value else mem_empty).append((one if value|length == 1 else many, none_label, value|length)) %}{% endfor %}
      {% if mem_found %}
      <li>Recovered: {% for label, _, n in mem_found %}{{ n }} {{ label }}{{ ", " if not loop.last }}{% endfor %}.</li>
      {% endif %}
      {% if mem_empty %}
      <li>Nothing recovered for: {% for _, label, n in mem_empty %}{{ label }}{{ ", " if not loop.last }}{% endfor %}.</li>
      {% endif %}
    </ul>
    {% endif %}
  </section>

  {% if glossary %}
  <section>
    <div class="section-head"><h2>Glossary</h2></div>
    <dl class="glossary">
      {% for term, definition in glossary %}
      <dt>{{ term }}</dt><dd>{{ definition }}</dd>
      {% endfor %}
    </dl>
  </section>
  {% endif %}

  {# Machine-wide accounts and devices are not printed; they stay in findings.json. #}

  <section class="declaration">
    <div class="band" style="break-before: page;">
      <div class="eyebrow">Declaration</div>
      <h2>Examiner's declaration</h2>
    </div>
    <p class="note">I confirm that I examined the evidence listed in "Evidence examined" using the tool and method described in this report; that the evidence verified as stated there; that the facts in this report are, to the best of my knowledge, true and complete; and that the sections marked as interpretation are opinions I have reviewed and accept, within the limitations stated.</p>
    <dl class="sign-grid">
      <dt>Name</dt><dd></dd>
      <dt>Position / organisation</dt><dd></dd>
      <dt>Case reference</dt><dd></dd>
      <dt>Signature</dt><dd></dd>
      <dt>Date</dt><dd></dd>
    </dl>
    <p class="note" style="margin-top:14px;">Report produced from findings.json{% if findings_sha256 %} with SHA-256 <span class="mono">{{ findings_sha256 }}</span>{% endif %}.</p>
  </section>

  <footer>
    <span>TRANCE{% if provenance %} {{ provenance.tool.version }}{% endif %} · findings.json schema v{{ findings.schema_version }}</span>
    {% if findings_sha256 %}
    <span>findings.json SHA-256 {{ findings_sha256 }}</span>
    {% endif %}
    <span>{{ findings.generated_at }}</span>
  </footer>

</div>
</body>
</html>
